# ==============================================================================
# Sahayak Environment Configuration Template
# Copy this file to .env.local and fill in the values for your local environment.
# Never commit real secrets to version control.
# ==============================================================================

# Supabase Public Configuration (Accessible on client and server)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key-here

# Supabase Server-Only Secret (NEVER expose to client-side code)
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key-here

# Google Gemini API Key (Server-Only, for AI multimodal job post parsing and matching)
GEMINI_API_KEY=your-gemini-api-key-here

# Application Configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_APP_URL=http://localhost:3000
